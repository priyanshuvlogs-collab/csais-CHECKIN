# ---- Database ----
# PostgreSQL (default). Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://csais:csais_dev_password@localhost:5432/csais"
# SQLite fallback (also change provider in prisma/schema.prisma to "sqlite"):
# DATABASE_URL="file:./dev.db"

# ---- Auth (NextAuth) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
# Public URL of the app (used by NextAuth in production)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---- Uploads ----
# Absolute or relative directory where check-in media files are stored on disk.
UPLOAD_DIR="./uploads"

# ---- Timezone ----
# Display / report timezone. Keep as America/Toronto for CSAIS.
APP_TIMEZONE="America/Toronto"

# ---- Optional email (SMTP) for admin alerts + daily report ----
# Leave empty to disable email. In-app + browser notifications always work.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CSAIS Dispatch <dispatch@csais.local>"

# ---- Seed admin (used by `npm run db:seed`) ----
SEED_ADMIN_EMAIL="admin@csais.local"
SEED_ADMIN_PASSWORD="ChangeMe!123"
